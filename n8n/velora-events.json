                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "velora-0111-0000-4000-8000-000000000111",
                    "leftValue": "={{ $json.duplicate ? 'duplicate' : $json.event }}",
                    "rightValue": "^appointment\\.(created|rescheduled|cancelled)$",
