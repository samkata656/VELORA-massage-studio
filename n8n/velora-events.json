                  "version": 2
                },
                "conditions": [
                  {
                    "id": "velora-0112-0000-4000-8000-000000000112",
                    "leftValue": "={{ $json.duplicate ? 'duplicate' : $json.event }}",
                    "rightValue": "^rota\\.updated$",
                    "operator": {
                      "type": "string",
                      "operation": "regex"
                    }
                  }
                ],
