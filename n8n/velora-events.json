    {
      "parameters": {
        "jsCode": "// Checks X-Velora-Signature = hex HMAC-SHA256(body, WEBHOOK_SECRET).\n// VELORA signs JSON.stringify(payload); n8n parses the body, and re-stringifying it gives the same bytes.\n// Self-hosted n8n: allow the crypto module with NODE_FUNCTION_ALLOW_BUILTIN=crypto.\nconst crypto = require('crypto');\nconst secret = $('Settings').first().json.WEBHOOK_SECRET;\nconst req = $('Velora event').first().json;\nconst body = req.body ?? {};\nconst given = String(req.headers['x-velora-signature'] ?? '');\nconst expected = crypto.createHmac('sha256', secret).update(JSON.stringify(body)).digest('hex');\nconst ok = !!secret && given.length === expected.length &&\n  crypto.timingSafeEqual(Buffer.from(given), Buffer.from(expected));\n\n// VELORA retries failed sends, so skip event ids that were already handled.\nconst store = $getWorkflowStaticData('global');\nstore.seen = store.seen ?? [];\nconst duplicate = ok && store.seen.includes(body.id);\nif (ok && !duplicate) store.seen = [...store.seen, body.id].slice(-500);\n\nreturn [{ json: { ok, duplicate, ...body } }];"
      },
