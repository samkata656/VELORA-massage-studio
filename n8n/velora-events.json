    {
      "parameters": {
        "jsCode": "// Builds the client email in the booking's language (bg/en).\nconst e = $json;\nconst a = e.data ?? {};\nconst to = a.client?.email;\nif (!to) return [];\nconst bg = a.locale !== 'en';\nconst name = bg ? a.procedure?.nameBg : a.procedure?.nameEn;\nconst when = a.localDate + ' ' + a.localTime;\nconst T = {\n  'appointment.created': bg\n    ? ['Резервацията ви е потвърдена', 'Очакваме ви за <b>' + name + '</b> на <b>' + when + '</b>.']\n    : ['Your booking is confirmed', 'We look forward to seeing you for <b>' + name + '</b> on <b>' + when + '</b>.'],\n  'appointment.rescheduled': bg\n    ? ['Резервацията ви е преместена', 'Новият час за <b>' + name + '</b> е <b>' + when + '</b>.']\n    : ['Your booking has moved', 'Your <b>' + name + '</b> is now on <b>' + when + '</b>.'],\n  'appointment.cancelled': bg\n    ? ['Резервацията ви е отменена', 'Резервацията за <b>' + name + '</b> на ' + when + ' е отменена.']\n    : ['Your booking is cancelled', 'Your <b>' + name + '</b> on ' + when + ' has been cancelled.'],\n}[e.event];\nif (!T) return [];\nconst esc = (s) => String(s ?? '').replace(/[&<>\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\nconst lines = [\n  (bg ? 'Здравейте, ' : 'Hello ') + esc(a.client?.name) + ',',\n  T[1],\n  (bg ? 'Код: ' : 'Booking code: ') + '<b>' + esc(a.code) + '</b> · ' + a.durationMin + ' min · ' + a.price?.amount + ' ' + a.price?.currency,\n];\nif (e.event !== 'appointment.cancelled') {\n  lines.push('<a href=\"' + esc(a.manageUrl) + '\">' + (bg ? 'Управление на резервацията' : 'Manage your booking') + '</a>');\n}\nlines.push('VELORA · +359 88 712 4560');\nreturn [{ json: { to, subject: 'VELORA · ' + T[0] + ' (' + a.code + ')', html: lines.map((l) => '<p>' + l + '</p>').join('') } }];"
      },
