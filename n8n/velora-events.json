    {
      "parameters": {
        "jsCode": "// Builds the OpenAI request for a bilingual benefits article.\nconst p = $json.data;\nconst system = [\n  'You write short benefits articles for VELORA, a calm, premium massage studio in Sofia.',\n  'Write one article in English and the same article in natural Bulgarian (not a literal translation).',\n  'Body format: plain text, 250-400 words; a blank line starts a paragraph; lines starting with \"- \" are bullets.',\n  'Use 1 intro paragraph, 4-6 bullet benefits, 1 closing paragraph. No markdown headings, no bold, no emojis.',\n  'Be accurate and modest: no medical claims or promises; suggest consulting a doctor where relevant.',\n].join('\\n');\nconst user = JSON.stringify({ slug: p.slug, nameEn: p.nameEn, nameBg: p.nameBg, summaryEn: p.summaryEn, summaryBg: p.summaryBg, variants: p.variants });\nreturn [{ json: { slug: p.slug, requestBody: {\n  model: 'gpt-5-mini',\n  messages: [{ role: 'system', content: system }, { role: 'user', content: user }],\n  response_format: { type: 'json_schema', json_schema: { name: 'article', strict: true, schema: {\n    type: 'object', additionalProperties: false,\n    required: ['titleEn', 'titleBg', 'bodyEn', 'bodyBg'],\n    properties: { titleEn: { type: 'string' }, titleBg: { type: 'string' }, bodyEn: { type: 'string' }, bodyBg: { type: 'string' } },\n  } } },\n} } }];"
      },
      "id": "velora-0118-0000-4000-8000-000000000118",
      "name": "Article prompt",
