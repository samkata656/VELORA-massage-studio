# Postgres (docker compose). Change the password for any server deployment.
POSTGRES_PASSWORD="velora_dev_pw"
DATABASE_URL="postgresql://velora:velora_dev_pw@localhost:5433/velora?schema=public"
APP_URL="http://localhost:3000"

# n8n integration — generate each secret with:  openssl rand -base64 36
# Key n8n sends as "Authorization: Bearer <key>" when calling /api/n8n/* (min. 32 characters; the API is off while empty)
N8N_API_KEY=""
# Where the app POSTs outbound events (appointment.created, procedure.deleted, ...)
N8N_WEBHOOK_URL=""
# HMAC-SHA256 secret used to sign outbound events (X-Velora-Signature header; nothing is sent while empty)
N8N_WEBHOOK_SECRET=""
# n8n webhook for the admin AI scheduling chat
N8N_SCHEDULER_WEBHOOK_URL=""

# Cloudflare Turnstile bot protection on login, registration and booking (off while the secret is empty).
# Keys: Cloudflare dashboard → Turnstile → Add widget. Local testing with Cloudflare's public test keys:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA (always passes)
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Accounts created by `npm run db:seed`. Leave a password empty to get a random one printed by the seed.
SEED_ADMIN_EMAIL="admin@velora-spa.bg"
SEED_ADMIN_PASSWORD=""
SEED_DEMO_EMAIL="demo@velora-spa.bg"
SEED_DEMO_PASSWORD=""
